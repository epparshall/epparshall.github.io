---
import '@fontsource-variable/inter';
import '@fontsource-variable/source-serif-4';
import { affiliate } from '../config/affiliate.mjs';

interface Props {
	title: string;
	description?: string;
	image?: string;
	type?: 'website' | 'article';
	publishedDate?: Date;
	/** Extra schema.org structured data for this page (a Review, a BlogPosting, ...). */
	jsonLd?: Record<string, unknown>;
}

const siteDescription = 'Personal website of Evan Parshall, a software engineer in Westfield, Indiana, featuring writing on technology, books, travel, publications, and projects.';
const {
	title,
	description = siteDescription,
	image = '/og-image.png',
	type = 'website',
	publishedDate,
	jsonLd,
} = Astro.props;
const siteUrl = 'https://epparshall.github.io';
const pageTitle = title === 'Home' ? 'Evan Parshall | Software Engineer' : `${title} | Evan Parshall`;
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const ogImageUrl = new URL(image, siteUrl).toString();
const isDefaultImage = image === '/og-image.png';

const navLinks = [
	{ href: '/blog', label: 'Blog' },
	{ href: '/books', label: 'Books' },
	{ href: '/travel', label: 'Travel' },
	{ href: '/work', label: 'Work' },
];
const currentPath = Astro.url.pathname.replace(/\/$/, '');
const isActive = (href: string) => currentPath === href || currentPath.startsWith(`${href}/`);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="google-site-verification" content="mStX5HFaKoTwPV2GHkRx3195B4iVjpJXRhnWIZlot-8" />
		<meta name="description" content={description} />
		<meta name="author" content="Evan Parshall" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="alternate icon" href="/favicon.ico" />
		<link rel="canonical" href={canonicalUrl} />
		<meta name="generator" content={Astro.generator} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content={type} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:site_name" content="Evan Parshall" />
		<meta property="og:image" content={ogImageUrl} />
		{isDefaultImage && <meta property="og:image:width" content="1200" />}
		{isDefaultImage && <meta property="og:image:height" content="630" />}
		<meta property="og:image:alt" content={isDefaultImage ? 'Evan Parshall personal website preview' : title} />
		{publishedDate && <meta property="article:published_time" content={publishedDate.toISOString()} />}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />
		<link rel="alternate" type="application/rss+xml" title="Evan Parshall | Blog" href="/rss.xml" />
		<title>{pageTitle}</title>
		<script type="application/ld+json">
		{
		  "@context": "https://schema.org",
		  "@type": "Person",
		  "name": "Evan Parshall",
		  "url": "https://epparshall.github.io",
		  "sameAs": [
			"https://www.linkedin.com/in/evanparshall/",
			"https://github.com/epparshall"
		  ],
		  "jobTitle": "Software Engineer",
		  "address": {
			"@type": "PostalAddress",
			"addressLocality": "Westfield",
			"addressRegion": "IN"
		  }
		}
		</script>
		{jsonLd && (
			<script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', ...jsonLd }).replace(/</g, '\\u003c')} />
		)}
		<!-- Cloudflare Web Analytics --><script defer src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "d460b89e55754f0dabee6beb4ff217b2"}'></script><!-- End Cloudflare Web Analytics -->
		<script is:inline>
			document.addEventListener('click', (event) => {
				const link = event.target.closest('a');
				if (link && link.href && (link.protocol === 'http:' || link.protocol === 'https:')) {
					const isExternal = link.origin !== window.location.origin;
					if (isExternal) {
						link.target = '_blank';
						if (!link.rel) {
							link.rel = 'noopener noreferrer';
						}
					}
				}
			}, true);
		</script>
	</head>
	<body>
		<a class="skip-link" href="#main-content">Skip to content</a>
		<header class="site-header">
			<nav aria-label="Main">
				<div class="logo">
					<a href="/">Evan Parshall</a>
				</div>
				<ul class="nav-links">
					{navLinks.map(({ href, label }) => (
						<li><a href={href} aria-current={isActive(href) ? 'page' : undefined}>{label}</a></li>
					))}
				</ul>
			</nav>
		</header>
		<main id="main-content">
			<slot />
		</main>
		<footer class="site-footer">
			<div class="footer-content">
				<p class="copyright">&copy; {new Date().getFullYear()} Evan Parshall. Built with Astro.</p>
				<p class="btc-address" title="Bitcoin tip address"><span class="btc-icon" aria-hidden="true">₿</span><span class="sr-only">Bitcoin tip address:</span> 14TtsUitabwmVtehspNEfao9CMLzGK7p83</p>
				<p><a href="mailto:epparshall.gcp@gmail.com">epparshall.gcp@gmail.com</a> &middot; <a href="/rss.xml">RSS</a></p>
			</div>
			{affiliate.amazonTag && (
				<p class="affiliate-disclosure">As an Amazon Associate I earn from qualifying purchases. Links to products may earn me a small commission at no extra cost to you.</p>
			)}
		</footer>
	</body>
</html>

<style is:global>
	:root {
		--font-sans: 'Inter Variable', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
		--font-serif: 'Source Serif 4 Variable', Georgia, 'Times New Roman', serif;
		--color-bg: #f7f8f5;
		--color-surface: #ffffff;
		--color-surface-muted: #eef3ef;
		--color-text: #202724;
		--color-text-light: #617168;
		--color-accent: #2f6f5e;
		--color-accent-strong: #1f5648;
		--color-accent-warm: #a65645;
		--color-accent-soft: rgba(47, 111, 94, 0.12);
		--color-border: #dce4df;
		--max-width: 980px;
		--content-width: 760px;
		--radius: 8px;
		--shadow-sm: 0 1px 2px rgba(32, 39, 36, 0.05);
		--shadow-md: 0 14px 35px rgba(32, 39, 36, 0.1);
	}

	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	body {
		font-family: var(--font-sans);
		line-height: 1.7;
		color: var(--color-text);
		background:
			linear-gradient(180deg, rgba(238, 243, 239, 0.8) 0, rgba(247, 248, 245, 0) 18rem),
			var(--color-bg);
		min-height: 100vh;
		-webkit-font-smoothing: antialiased;
	}

	@media (max-width: 600px) {
		body {
			line-height: 1.65;
		}
	}

	.site-header {
		max-width: var(--max-width);
		margin: 0 auto 5rem;
		padding: 2.5rem 1.5rem 0;
	}

	@media (max-width: 600px) {
		.site-header {
			margin-bottom: 2rem;
			padding: 1rem 1rem 0;
		}
	}

	.site-header nav {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1.5rem;
		padding-bottom: 1.25rem;
		border-bottom: 1px solid rgba(220, 228, 223, 0.85);
	}

	@media (max-width: 600px) {
		.site-header nav {
			align-items: flex-start;
			gap: 0.75rem;
			padding-bottom: 0.85rem;
		}
	}

	.logo a {
		font-size: 1.25rem;
		font-weight: 800;
		text-decoration: none;
		color: var(--color-text);
		letter-spacing: 0;
	}

	.nav-links {
		display: flex;
		list-style: none;
		gap: 0.5rem;
		padding-left: 0;
		margin-bottom: 0;
	}

	@media (max-width: 600px) {
		.nav-links {
			width: 100%;
			gap: 0.15rem;
			flex-wrap: nowrap;
			justify-content: flex-start;
			overflow-x: auto;
			-webkit-overflow-scrolling: touch;
			scrollbar-width: none;
		}

		.nav-links::-webkit-scrollbar {
			display: none;
		}
	}

	.nav-links a {
		display: inline-flex;
		align-items: center;
		min-height: 2.25rem;
		padding: 0.35rem 0.7rem;
		border-radius: var(--radius);
		text-decoration: none;
		color: var(--color-text-light);
		font-size: 0.95rem;
		font-weight: 650;
		transition: background-color 0.2s ease, color 0.2s ease;
	}

	.nav-links a:hover,
	.nav-links a[aria-current='page'] {
		background: var(--color-accent-soft);
		color: var(--color-accent-strong);
		opacity: 1;
	}

	.skip-link {
		position: absolute;
		left: 1rem;
		top: -3rem;
		z-index: 100;
		padding: 0.5rem 0.9rem;
		border-radius: var(--radius);
		background: var(--color-accent-strong);
		color: #fff;
		font-weight: 650;
	}

	.skip-link:focus {
		top: 1rem;
		color: #fff;
	}

	:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 2px;
	}

	@media (max-width: 600px) {
		.logo a {
			font-size: 1.05rem;
			white-space: nowrap;
		}

		.site-header nav {
			align-items: center;
		}

		.nav-links a {
			min-height: 2rem;
			padding: 0.25rem 0.45rem;
			font-size: 0.82rem;
			white-space: nowrap;
		}

		main {
			padding: 0 1rem;
		}
	}

	main {
		min-height: 60vh;
		max-width: var(--max-width);
		margin: 0 auto;
		padding: 0 1.5rem;
	}

	.site-footer {
		max-width: var(--max-width);
		margin-top: 8rem;
		margin-left: auto;
		margin-right: auto;
		padding: 3rem 1.5rem 3.5rem;
		border-top: 1px solid var(--color-border);
		font-size: 0.9rem;
		color: var(--color-text-light);
	}

	@media (max-width: 600px) {
		.site-footer {
			margin-top: 5rem;
			padding-bottom: 2.5rem;
		}
	}

	.footer-content {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 1rem 1.5rem;
	}

	@media (max-width: 600px) {
		.footer-content {
			align-items: flex-start;
			text-align: left;
		}
	}

	.footer-content p {
		margin-bottom: 0;
	}

	.btc-address {
		overflow-wrap: anywhere;
	}

	.affiliate-disclosure {
		margin: 1.5rem 0 0;
		font-size: 0.8rem;
	}

	.btc-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.1rem;
		height: 1.1rem;
		background-color: #F7931A;
		color: white;
		border-radius: 50%;
		font-size: 0.75rem;
		font-weight: bold;
		vertical-align: middle;
		margin-right: 0.25rem;
		line-height: 1;
		padding-bottom: 0.05rem;
	}

	h1, h2, h3 {
		margin-bottom: 1.5rem;
		line-height: 1.25;
		color: var(--color-text);
		letter-spacing: 0;
		font-weight: 700;
	}

	h1 { font-size: clamp(2.35rem, 5vw, 3.75rem); }
	h2 { font-size: 2rem; margin-top: 3rem; }
	h3 { font-size: 1.5rem; margin-top: 2rem; }

	@media (max-width: 600px) {
		h2 { font-size: 1.75rem; }
	}

	p {
		margin-bottom: 1.5rem;
	}

	ul, ol {
		margin-bottom: 1.5rem;
		padding-left: 1.5rem;
	}

	li {
		margin-bottom: 0.75rem;
	}

	a {
		color: var(--color-accent);
		text-decoration: none;
		transition: color 0.2s ease, opacity 0.2s ease;
	}

	a:hover {
		color: var(--color-accent-strong);
		opacity: 0.9;
	}

	/* Utility Classes */
	.blog-post, .travel-detail, .book-detail, .resource-detail {
		max-width: var(--content-width);
		margin: 0 auto;
	}

	/* Long-form writing is set in a serif; headings, tables, and captions stay in the
	   interface sans so the page keeps one voice for structure and one for reading. */
	.content {
		font-family: var(--font-serif);
		font-optical-sizing: auto;
	}

	.content :is(h1, h2, h3, h4, table, figcaption) {
		font-family: var(--font-sans);
	}

	/* Links inside long-form writing are underlined so they read as links. */
	.content a {
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.18em;
	}

	/* Wide markdown tables scroll sideways on small screens instead of clipping. */
	.table-scroll {
		overflow-x: auto;
		-webkit-overflow-scrolling: touch;
		margin: 3rem 0;
	}

	.table-scroll > table {
		margin: 0 !important;
	}

	::selection {
		background: var(--color-accent-soft);
		color: var(--color-text);
	}
</style>
