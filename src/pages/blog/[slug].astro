---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
	const blogEntries = await getCollection('blog', ({ data }) => {
		return data.draft !== true;
	});
	return blogEntries.map(entry => ({
		params: { slug: entry.id }, props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

// ~230 words a minute, ignoring markdown/HTML syntax and footnote definitions.
const words = (entry.body ?? '')
	.replace(/^\[\^[^\]]+\]:.*$/gm, '')
	.replace(/<[^>]+>|!?\[([^\]]*)\]\([^)]*\)|[#*_`>|-]/g, ' $1 ')
	.split(/\s+/)
	.filter(Boolean).length;
const readingMinutes = Math.max(1, Math.round(words / 230));

// Long posts get an automatic table of contents, unless the post already has its own.
const sections = headings.filter((h) => h.depth === 2 && h.slug !== 'footnote-label');
const hasOwnContents = sections.some((h) => /^contents$/i.test(h.text.trim()));
const showToc = !hasOwnContents && sections.length >= 4 && words >= 1200;
const publishedEntries = await getCollection('blog', ({ data }) => {
	return data.draft !== true;
});
const seriesEntries = entry.data.seriesTitle
	? publishedEntries
		.filter((post) => post.data.seriesTitle === entry.data.seriesTitle)
		.sort((a, b) => (a.data.seriesPart || 0) - (b.data.seriesPart || 0))
	: [];
const evan = { '@type': 'Person', name: 'Evan Parshall', url: 'https://epparshall.github.io' };
const postJsonLd = {
	'@type': 'BlogPosting',
	headline: entry.data.title,
	description: entry.data.description,
	url: new URL(`/blog/${entry.id}/`, Astro.site).toString(),
	datePublished: entry.data.pubDate.toISOString().slice(0, 10),
	author: evan,
	publisher: evan,
	...(entry.data.tags && { keywords: entry.data.tags.join(', ') }),
	...(entry.data.seriesTitle && { isPartOf: { '@type': 'CreativeWorkSeries', name: `${entry.data.seriesTitle} series` } }),
};
const currentSeriesIndex = seriesEntries.findIndex((post) => post.id === entry.id);
const previousSeriesEntry = currentSeriesIndex > 0 ? seriesEntries[currentSeriesIndex - 1] : null;
const nextSeriesEntry = currentSeriesIndex >= 0 && currentSeriesIndex < seriesEntries.length - 1
	? seriesEntries[currentSeriesIndex + 1]
	: null;
---

<BaseLayout
	title={entry.data.title}
	description={entry.data.description}
	type="article"
	publishedDate={entry.data.pubDate}
	jsonLd={postJsonLd}
>
	<article class="blog-post">
		<header>
			{entry.data.seriesTitle && entry.data.seriesPart && entry.data.seriesTotal && (
				<p class="series-label">
					{entry.data.seriesTitle} Series {entry.data.seriesPart}/{entry.data.seriesTotal}
				</p>
			)}
			<h1>{entry.data.title}</h1>
			<p class="post-meta">
				<time datetime={entry.data.pubDate.toISOString()}>
					{entry.data.pubDate.toLocaleDateString('en-US', {
						year: 'numeric',
						month: 'long',
						timeZone: 'UTC'
					})}
				</time>
				<span aria-hidden="true">&middot;</span>
				<span>{readingMinutes} min read</span>
			</p>
			{entry.data.tags && entry.data.tags.length > 0 && (
				<div class="post-tags">
					{entry.data.tags.map((tag) => (
						<span class="tag">{tag}</span>
					))}
				</div>
			)}
			{seriesEntries.length > 1 && (
				<nav
					class={`series-nav-compact${!previousSeriesEntry || !nextSeriesEntry ? ' single-link' : ''}`}
					aria-label={`${entry.data.seriesTitle} series quick navigation`}
				>
					{previousSeriesEntry ? (
						<a class="previous" href={`/blog/${previousSeriesEntry.id}`}>
							<span>Previous</span>
							<strong>{previousSeriesEntry.data.title}</strong>
						</a>
					) : (
						<span class="series-nav-compact-spacer" aria-hidden="true"></span>
					)}
					{nextSeriesEntry ? (
						<a class="next" href={`/blog/${nextSeriesEntry.id}`}>
							<span>Next</span>
							<strong>{nextSeriesEntry.data.title}</strong>
						</a>
					) : (
						<span class="series-nav-compact-spacer" aria-hidden="true"></span>
					)}
				</nav>
			)}
		</header>
		{showToc && (
			<details class="toc" open>
				<summary>On this page</summary>
				<ol>
					{sections.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
				</ol>
			</details>
		)}
		<div class="content">
			<Content />
		</div>
		<footer>
			{seriesEntries.length > 1 && (
				<nav class="series-nav" aria-label={`${entry.data.seriesTitle} series`}>
					{previousSeriesEntry ? (
						<a class="series-link previous" href={`/blog/${previousSeriesEntry.id}`}>
							<span>Previous</span>
							<strong>{previousSeriesEntry.data.title}</strong>
						</a>
					) : (
						<span class="series-link-placeholder" aria-hidden="true"></span>
					)}
					{nextSeriesEntry ? (
						<a class="series-link next" href={`/blog/${nextSeriesEntry.id}`}>
							<span>Next</span>
							<strong>{nextSeriesEntry.data.title}</strong>
						</a>
					) : (
						<span class="series-link-placeholder" aria-hidden="true"></span>
					)}
				</nav>
			)}
			<a href="/blog">&larr; Back to all posts</a>
		</footer>
	</article>
</BaseLayout>

<style>
	.series-label {
		display: inline-flex;
		align-items: center;
		min-height: 1.75rem;
		margin-bottom: 1rem;
		padding: 0.22rem 0.65rem;
		border: 1px solid rgba(166, 86, 69, 0.28);
		border-radius: 999px;
		background: rgba(166, 86, 69, 0.08);
		color: var(--color-accent-warm);
		font-size: 0.82rem;
		font-weight: 750;
		line-height: 1;
	}

	.blog-post h1 {
		margin-bottom: 0.75rem;
		font-size: clamp(2.35rem, 5vw, 3.75rem);
		letter-spacing: 0;
		line-height: 1.1;
	}

	@media (max-width: 600px) {
		.blog-post h1 {
			font-size: 2.25rem;
		}

		.content {
			font-size: 1.1rem;
		}

		.series-label {
			font-size: 0.76rem;
		}

		.series-nav-compact {
			display: flex;
			justify-content: space-between;
			align-items: flex-start;
			gap: 0.65rem;
			margin-bottom: 1.75rem;
		}

		.series-nav-compact-spacer {
			display: block;
			flex: 1 1 0;
			min-width: 0;
		}

		.series-nav-compact a {
			flex: 1 1 0;
			max-width: 50%;
		}

		.series-nav-compact .next {
			align-items: center;
			text-align: center;
		}

		.series-nav-compact.single-link {
			justify-content: center;
		}

		.series-nav-compact.single-link .series-nav-compact-spacer {
			display: none;
		}

		.series-nav-compact.single-link a {
			flex: 0 1 18rem;
			max-width: 100%;
		}

		.series-nav-compact.single-link .next,
		.series-nav-compact.single-link .previous {
			align-items: center;
			text-align: center;
		}
	}

	.post-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 1rem;
		font-size: 0.9rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-text-light);
	}

	.post-meta time {
		margin-bottom: 0 !important;
	}

	.toc {
		margin: 0 0 2.5rem;
		padding: 1rem 1.25rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		background: var(--color-surface);
		font-size: 0.95rem;
	}

	.toc summary {
		cursor: pointer;
		font-weight: 700;
		font-size: 0.8rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-text-light);
	}

	.toc ol {
		margin: 0.75rem 0 0;
		padding-left: 1.25rem;
	}

	.toc li {
		margin-bottom: 0.35rem;
	}

	.toc a {
		color: var(--color-text);
	}

	.toc a:hover {
		color: var(--color-accent-strong);
	}

	.blog-post time {
		display: block;
		font-size: 0.9rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-text-light);
		margin-bottom: 1rem;
	}

	.post-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 1.5rem;
	}

	.tag {
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		padding: 0.2rem 0.65rem;
		background-color: var(--color-surface-muted, #f4f7f5);
		color: var(--color-text-light);
		border-radius: 999px;
		border: 1px solid var(--color-border);
	}

	.series-nav-compact {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem;
		margin: 0 0 2.5rem;
		padding: 0.8rem 0;
		border-top: 1px solid var(--color-border);
		border-bottom: 1px solid var(--color-border);
	}

	.series-nav-compact a {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.2rem;
		min-width: 0;
		color: var(--color-text);
		text-align: center;
		text-decoration: none;
	}

	.series-nav-compact .next {
		align-items: center;
		justify-self: stretch;
		text-align: center;
	}

	.series-nav-compact a:hover {
		color: var(--color-accent-strong);
		opacity: 1;
	}

	.series-nav-compact span {
		color: var(--color-text-light);
		font-size: 0.72rem;
		font-weight: 750;
		letter-spacing: 0.08em;
		line-height: 1;
		text-transform: uppercase;
	}

	.series-nav-compact strong {
		display: block;
		font-size: 0.95rem;
		line-height: 1.35;
		overflow-wrap: break-word;
	}

	.content {
		line-height: 1.8;
		font-size: 1.25rem;
		color: var(--color-text);
	}

	.content p {
		margin-bottom: 2rem;
	}

	.content :global(img) {
		display: block !important;
		margin: 4rem auto !important;
		max-width: 100% !important;
		width: auto !important;
		height: auto !important;
		border-radius: var(--radius);
		box-shadow: var(--shadow-md);
	}

	/* Target book covers specifically */
	.content :global(img[alt*="Cover"]),
	.content :global(img[src*="walker_book"]) {
		max-width: 320px !important;
	}

	.content :global(p:has(img)) {
		text-align: center !important;
		width: 100% !important;
	}

	.content :global(p) {
		margin-bottom: 2rem;
		overflow-wrap: break-word;
		word-break: break-word;
		text-align: left;
	}

	/* Captions */
	.content :global(p:has(img) + p:has(> em:only-child)),
	.content :global(p:has(img) + p:has(> i:only-child)) {
		text-align: center !important;
		margin-top: -3rem !important;
		margin-bottom: 4rem !important;
	}

	.content :global(p:has(img) + p > em:only-child),
	.content :global(p:has(img) + p > i:only-child) {
		display: block !important;
		max-width: 600px !important;
		margin: 0 auto !important;
		font-size: 0.9rem;
		color: var(--color-text-light);
		line-height: 1.5;
		font-style: italic;
	}

	.content :global(.callout) {
		background-color: var(--color-accent-soft);
		border-left: 4px solid var(--color-accent);
		padding: 2rem;
		margin: 3rem 0;
		border-radius: 0 var(--radius) var(--radius) 0;
		font-size: 1.15rem;
		line-height: 1.6;
		font-style: italic;
		color: var(--color-text);
	}

	.content :global(.callout a) {
		color: var(--color-accent);
		text-decoration: underline;
		font-weight: 600;
	}

	/* Table Styles */
	.content :global(table) {
		width: 100%;
		border-collapse: separate;
		border-spacing: 0;
		table-layout: auto;
		margin: 3rem 0;
		font-size: 1rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		overflow: hidden;
		box-shadow: var(--shadow-sm);
	}

	@media (max-width: 600px) {
		.content :global(table) {
			font-size: 0.82rem;
		}

		.content :global(th),
		.content :global(td) {
			padding: 0.65rem;
		}
	}

	.content :global(th) {
		background-color: var(--color-surface-muted);
		color: var(--color-text);
		font-weight: 700;
		text-align: left;
		padding: 1.25rem;
		border-bottom: 2px solid var(--color-border);
		overflow-wrap: break-word;
	}

	.content :global(td) {
		padding: 1.25rem;
		border-bottom: 1px solid var(--color-border);
		color: var(--color-text-light);
		vertical-align: top;
		overflow-wrap: break-word;
	}

	.content :global(tr:last-child td) {
		border-bottom: none;
	}

	.content :global(tr:nth-child(even)) {
		background-color: rgba(238, 243, 239, 0.45);
	}

	.content :global(tr:hover) {
		background-color: var(--color-accent-soft);
	}

	.content :global(td:nth-child(2)),
	.content :global(td:nth-child(4)),
	.content :global(td:nth-child(5)),
	.content :global(th:nth-child(2)),
	.content :global(th:nth-child(4)),
	.content :global(th:nth-child(5)) {
		text-align: right;
	}

	.blog-post footer {
		margin-top: 6rem;
		padding-top: 3rem;
		border-top: 1px solid var(--color-border);
	}

	.series-nav {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
		margin-bottom: 2.5rem;
	}

	.series-link {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		min-height: 5.5rem;
		padding: 1rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		background: var(--color-surface);
		text-decoration: none;
		box-shadow: var(--shadow-sm);
		transition: border-color 0.2s ease;
	}

	.series-link:hover {
		border-color: rgba(47, 111, 94, 0.45);
		opacity: 1;
	}

	.series-link span {
		color: var(--color-text-light);
		font-size: 0.78rem;
		font-weight: 750;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.series-link strong {
		color: var(--color-text);
		font-size: 1rem;
		line-height: 1.35;
	}

	.series-link.next {
		text-align: right;
	}

	@media (max-width: 600px) {
		.series-nav {
			grid-template-columns: 1fr;
			gap: 0.75rem;
		}

		.series-link-placeholder {
			display: none;
		}

		.series-link.next {
			text-align: left;
		}
	}

	.blog-post footer a {
		font-weight: 600;
		color: var(--color-text-light);
		transition: color 0.2s;
	}

	.blog-post footer a:hover {
		color: var(--color-accent);
	}

	@media (max-width: 600px) {
		.series-nav-compact.single-link {
			display: block;
			text-align: center;
		}

		.series-nav-compact.single-link .series-nav-compact-spacer {
			display: none;
		}

		.series-nav-compact.single-link a {
			display: block;
			width: 100%;
			max-width: none;
			text-align: center;
		}

		.series-nav-compact.single-link span,
		.series-nav-compact.single-link strong {
			display: block;
			text-align: center;
		}
	}
</style>
