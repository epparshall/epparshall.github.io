---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { affiliate, amazonBookUrl } from '../../config/affiliate.mjs';

export async function getStaticPaths() {
	const bookEntries = await getCollection('books');
	return bookEntries.map(entry => ({
		params: { slug: entry.id }, props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// Get the rank
const rankingsEntry = await getEntry('rankings', 'rankings');
const favoriteOrder = rankingsEntry?.data.favoriteBooks || [];
const honorableMentionsOrder = rankingsEntry?.data.honorableMentions || [];

const rankIndex = favoriteOrder.indexOf(entry.id);
const rank = rankIndex !== -1 ? rankIndex + 1 : null;
const isHonorableMention = honorableMentionsOrder.includes(entry.id);
const shortTitle = entry.data.title.split(':')[0];
const buyUrl = amazonBookUrl(shortTitle, entry.data.author);
---

<BaseLayout
	title={shortTitle}
	description={`Evan Parshall's review of ${shortTitle} by ${entry.data.author}: what stuck, what did not, and who should read it.`}
	image={entry.data.image}
	type="article"
>
	<article class="book-detail">
		<header>
			{rank && <p class="rank">#{rank} Favorite</p>}
			{isHonorableMention && <p class="rank">Honorable Mention</p>}
			<div class="header-content">
				{entry.data.image && (
					<div class="book-cover">
						<img src={entry.data.image} alt={entry.data.title} />
					</div>
				)}
				<div class="book-titles">
					<h1>{entry.data.title}</h1>
					<p class="author">by {entry.data.author}</p>
					<div class="meta">
						{entry.data.rating && (
							<span class="rating">{entry.data.rating}/5 stars</span>
						)}
						<a
							class="buy-link"
							href={buyUrl}
							rel={affiliate.amazonTag ? 'sponsored noopener noreferrer' : 'noopener noreferrer'}
						>
							Find this book &rarr;
						</a>
					</div>
				</div>
			</div>
		</header>
		<hr />
		<div class="content">
			<Content />
		</div>
		<footer>
			<a href="/books">&larr; Back to all books</a>
		</footer>
	</article>
</BaseLayout>

<style>
	.book-detail {
		max-width: var(--content-width);
		margin: 0 auto;
	}

	.book-detail header {
		margin-bottom: 4rem;
	}

	.rank {
		font-size: 0.85rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-accent);
		margin-bottom: 1.5rem;
		display: inline-block;
		padding: 0.25rem 0.75rem;
		background: var(--color-accent-soft);
		border-radius: var(--radius);
	}

	.header-content {
		display: flex;
		gap: 3rem;
		align-items: flex-start;
		margin-top: 1rem;
	}

	.book-cover {
		width: 200px;
		flex-shrink: 0;
	}

	.book-cover img {
		width: 100%;
		height: auto;
		border-radius: var(--radius);
		box-shadow: var(--shadow-md);
		border: 1px solid var(--color-border);
	}

	.book-titles {
		flex: 1;
	}

	.book-detail h1 {
		font-size: clamp(2.35rem, 5vw, 3.75rem);
		margin-bottom: 0.75rem;
		letter-spacing: 0;
		line-height: 1.1;
	}

	.author {
		font-size: 1.5rem;
		color: var(--color-text-light);
		margin-bottom: 1.5rem;
		font-weight: 400;
	}

	.meta {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.rating {
		font-weight: 700;
		color: var(--color-text);
		font-size: 0.95rem;
		background: var(--color-surface);
		padding: 0.4rem 0.8rem;
		border-radius: var(--radius);
		border: 1px solid var(--color-border);
	}

	.buy-link {
		font-size: 0.95rem;
		font-weight: 650;
		color: var(--color-accent-strong);
		padding: 0.4rem 0.8rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		background: var(--color-surface);
	}

	.buy-link:hover {
		background: var(--color-accent-soft);
		border-color: rgba(47, 111, 94, 0.45);
		opacity: 1;
	}

	hr {
		border: 0;
		border-top: 1px solid var(--color-border);
		margin: 4rem 0;
	}

	.content {
		line-height: 1.8;
		font-size: 1.25rem;
		color: var(--color-text);
	}

	.book-detail footer {
		margin-top: 6rem;
		padding-top: 3rem;
		border-top: 1px solid var(--color-border);
	}

	.book-detail footer a {
		font-weight: 600;
		color: var(--color-text-light);
		transition: color 0.2s;
	}

	.book-detail footer a:hover {
		color: var(--color-accent);
	}

	@media (max-width: 600px) {
		.book-detail header {
			text-align: center;
			margin-bottom: 3rem;
		}

		.header-content {
			flex-direction: column;
			align-items: center;
			gap: 2rem;
		}

		.book-detail h1 {
			font-size: 2.25rem;
		}

		.author {
			font-size: 1.25rem;
		}

		.meta {
			justify-content: center;
		}

		.content {
			font-size: 1.1rem;
		}
	}
</style>
