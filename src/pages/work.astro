---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const pubs = await getCollection('publications');
pubs.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const pubsWithContent = await Promise.all(
	pubs.map(async (pub) => {
		const { Content } = await render(pub);
		return { ...pub, Content };
	})
);
---

<BaseLayout title="Work" description="Research papers, professional writing, and apps by Evan Parshall, including the Ballast paced-breathing app for iPhone and Apple Watch.">
	<header class="page-header">
		<h1>Work</h1>
		<p class="subtitle">Research papers, professional writing, and things I have built.</p>
	</header>

	<div class="pubs-list">
		{pubsWithContent.map((pub) => (
			<article class="pub-card">
				<div class="pub-info">
					<p class="pub-meta">
						{pub.data.publisher} &middot; {pub.data.pubDate.toLocaleDateString('en-US', {
							year: 'numeric',
							month: 'long',
						})}
					</p>
					<h2><a href={pub.data.link}>{pub.data.title}</a></h2>
					<div class="pub-summary">
						<pub.Content />
					</div>
					<a href={pub.data.link} class="external-link">{pub.data.linkLabel ?? 'View publication'} &rarr;</a>
				</div>
			</article>
		))}
	</div>
</BaseLayout>

<style>
	.page-header {
		margin-bottom: 4rem;
	}

	.page-header h1 {
		font-size: clamp(2.75rem, 6vw, 4rem);
		margin-bottom: 1.5rem;
		letter-spacing: 0;
		line-height: 1.08;
	}

	.subtitle {
		font-size: 1.25rem;
		color: var(--color-text-light);
		max-width: 50ch;
		line-height: 1.6;
	}

	.pubs-list {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.pub-card {
		padding: 2rem;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		box-shadow: var(--shadow-sm);
		transition: border-color 0.2s ease;
	}

	.pub-card:hover {
		border-color: rgba(47, 111, 94, 0.45);
		background: var(--color-surface);
	}

	.pub-meta {
		font-size: 0.85rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-text-light);
		margin-bottom: 1rem;
	}

	.pub-card h2 {
		margin-top: 0;
		font-size: 1.75rem;
		margin-bottom: 1.5rem;
		color: var(--color-text);
		line-height: 1.3;
	}

	.pub-card h2 a {
		text-decoration: none;
		color: inherit;
	}

	.pub-summary {
		margin-bottom: 2rem;
		line-height: 1.7;
		color: var(--color-text-light);
		font-size: 1.1rem;
	}

	.pub-summary :global(p) {
		margin-bottom: 0;
	}

	.pub-summary :global(p + p) {
		margin-top: 1rem;
	}

	.external-link {
		font-size: 0.95rem;
		font-weight: 600;
		color: var(--color-accent-strong);
		text-decoration: none;
	}

	@media (max-width: 600px) {
		.page-header {
			margin-bottom: 1.75rem;
			text-align: left;
		}

		.page-header h1 {
			font-size: 2.3rem;
			margin-bottom: 0.75rem;
		}

		.subtitle {
			font-size: 1rem;
			line-height: 1.45;
			margin-bottom: 0;
		}

		.pub-card {
			padding: 1.15rem;
		}

		.pub-card h2 {
			font-size: 1.35rem;
			margin-bottom: 0.9rem;
		}

		.pub-summary {
			font-size: 1rem;
			line-height: 1.5;
			margin-bottom: 1.25rem;
		}

		.pub-meta {
			margin-bottom: 0.65rem;
		}
	}
</style>
