---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Home">
	<section class="hero">
		<div class="hero-content">
			<div class="hero-text">
				<h1>Hi, I'm Evan Parshall</h1>
				<p>
					I'm a software engineer based in Westfield, Indiana.
				</p>
				<p>
					This is where I share my thoughts, book recommendations, travel experiences, and professional work.
				</p>
			</div>
			<div class="hero-image">
				<img src="/images/evan-parshall.jpg" alt="Evan Parshall" />
			</div>
		</div>
	</section>

	<section class="links">
		<h2 class="section-title">Collections</h2>
		<div class="links-grid">
			<a href="/blog" class="link-card">
				<h2>Blog</h2>
				<p>Thoughts on technology, health and wellness, finance, travel, politics, and ideas worth sharing.</p>
			</a>
			<a href="/books" class="link-card">
				<h2>Books</h2>
				<p>Notes and rankings of the books I've read and recommend.</p>
			</a>
			<a href="/travel" class="link-card">
				<h2>Travel</h2>
				<p>Stories and advice from experiences traveling around the world.</p>
			</a>
			<a href="/work" class="link-card">
				<h2>Work</h2>
				<p>Research papers, professional writing, and apps I've built.</p>
			</a>
		</div>
	</section>

	<section class="connect">
		<h2 class="section-title">Connect</h2>
		<div class="connect-links">
			<a href="mailto:epparshall.gcp@gmail.com">Email</a>
			<a href="https://www.linkedin.com/in/evanparshall/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
			<a href="https://github.com/epparshall" target="_blank" rel="noopener noreferrer">GitHub</a>
		</div>
	</section>
</BaseLayout>

<style>
	.hero {
		padding: 1.5rem 0 4rem;
	}

	.hero-content {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 280px;
		align-items: center;
		gap: clamp(2.5rem, 7vw, 5rem);
	}

	.hero-text {
		max-width: 640px;
	}

	.hero-image {
		position: relative;
	}

	.hero-image img {
		width: 280px;
		height: 280px;
		object-fit: cover;
		border-radius: var(--radius);
		box-shadow: var(--shadow-md);
		border: 6px solid var(--color-surface);
	}

	.hero h1 {
		font-size: clamp(2.75rem, 6vw, 4.5rem);
		margin-bottom: 1.5rem;
		letter-spacing: 0;
		line-height: 1.05;
	}

	.hero p {
		font-size: 1.25rem;
		color: var(--color-text-light);
		max-width: 55ch;
		margin-bottom: 1.5rem;
	}

	.section-title {
		font-size: 0.85rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-text-light);
		margin-bottom: 2rem;
		border-bottom: 1px solid var(--color-border);
		padding-bottom: 0.5rem;
		display: inline-block;
	}

	.links-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 1rem;
		margin-bottom: 5rem;
	}

	.link-card {
		position: relative;
		padding: 1.5rem;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		box-shadow: var(--shadow-sm);
		transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
		text-decoration: none;
		color: inherit;
	}

	.link-card:hover {
		transform: translateY(-3px);
		box-shadow: var(--shadow-md);
		border-color: rgba(47, 111, 94, 0.45);
		opacity: 1;
	}

	.link-card h2 {
		margin-top: 0;
		font-size: 1.25rem;
		margin-bottom: 0.5rem;
		color: var(--color-text);
	}

	.link-card p {
		margin-bottom: 0;
		font-size: 0.95rem;
		color: var(--color-text-light);
	}

	.connect-links {
		display: flex;
		gap: 0.75rem;
		flex-wrap: wrap;
	}

	.connect-links a {
		font-weight: 650;
		color: var(--color-accent-strong);
		border: 1px solid var(--color-border);
		background: var(--color-surface);
		border-radius: var(--radius);
		padding: 0.45rem 0.8rem;
		transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
	}

	.connect-links a:hover {
		background: var(--color-accent-soft);
		border-color: rgba(47, 111, 94, 0.45);
		color: var(--color-accent-strong);
		opacity: 1;
	}

	@media (max-width: 768px) {
		.hero {
			padding: 0.75rem 0 2.5rem;
		}

		.hero-content {
			grid-template-columns: 1fr;
			text-align: left;
			gap: 1.75rem;
		}

		.hero h1 {
			font-size: 2.35rem;
			margin-bottom: 1rem;
		}

		.hero p {
			font-size: 1.05rem;
			line-height: 1.55;
			margin-bottom: 1rem;
		}

		.hero-image {
			justify-self: center;
		}

		.hero-image img {
			width: min(62vw, 220px);
			height: min(62vw, 220px);
		}

		.connect-links {
			justify-content: flex-start;
			gap: 0.75rem;
		}
	}
</style>
