---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const resources = await getCollection('travelResources');
resources.sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<BaseLayout title="Travel Tips & Resources" description="The gear, cards, apps, and habits Evan Parshall relies on for cheaper, lower-stress international travel.">
	<header class="page-header">
		<h1>General Tips & Resources</h1>
	</header>

	<ul class="resources-list">
		{resources.map(resource => (
			<li class="resource-card">
				<a href={`/travel/resources/${resource.id}`}>
					<h2>{resource.data.title}</h2>
					<p>{resource.data.description}</p>
				</a>
			</li>
		))}
	</ul>

	<footer>
		<a href="/travel">&larr; Back to Travel</a>
	</footer>
</BaseLayout>

<style>
	.resources-list {
		list-style: none;
		margin-top: 2rem;
		padding-left: 0;
		display: grid;
		gap: 1rem;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
	}

	.page-header {
		margin-bottom: 3rem;
	}

	.resource-card a {
		display: block;
		padding: 1.5rem;
		background: var(--color-surface);
		border-radius: var(--radius);
		text-decoration: none;
		color: inherit;
		border: 1px solid var(--color-border);
		box-shadow: var(--shadow-sm);
		transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
		height: 100%;
	}

	.resource-card a:hover {
		border-color: rgba(47, 111, 94, 0.45);
		transform: translateY(-3px);
		box-shadow: var(--shadow-md);
		opacity: 1;
	}

	.resource-card h2 {
		margin-bottom: 0.5rem;
		font-size: 1.25rem;
		color: var(--color-text);
		margin-top: 0;
	}

	.resource-card p {
		font-size: 0.95rem;
		color: var(--color-text-light);
		line-height: 1.4;
		margin-bottom: 0;
	}

	footer {
		margin-top: 4rem;
		padding-top: 2rem;
		border-top: 1px solid var(--color-border);
	}

	@media (max-width: 600px) {
		.page-header {
			margin-bottom: 1.75rem;
		}

		.page-header h1 {
			font-size: 2.3rem;
			margin-bottom: 0;
		}

		.resources-list {
			grid-template-columns: 1fr;
			gap: 1rem;
		}

		.resource-card a {
			padding: 1.15rem;
		}
	}
</style>
