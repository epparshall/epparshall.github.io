---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
	const travelEntries = await getCollection('travel');
	return travelEntries.map(entry => ({
		params: { slug: entry.id }, props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout
	title={entry.data.destination}
	description={entry.data.description || `Evan Parshall's travel notes and stories from ${entry.data.destination}.`}
	image={entry.data.image}
	type="article"
>
	<article class="travel-detail">
		<header>
			<h1>{entry.data.destination}</h1>
			<time class="date" datetime={entry.data.date.toISOString()}>
				{entry.data.date.toLocaleDateString('en-US', {
					year: 'numeric',
					month: 'long',
					timeZone: 'UTC',
				})}
			</time>
			{entry.data.description && <p class="description">{entry.data.description}</p>}
		</header>
		<hr />
		<div class="content">
			<Content />
		</div>
		<footer>
			<a href="/travel">&larr; Back to travel</a>
		</footer>
	</article>
</BaseLayout>

<style>
	.travel-detail {
		max-width: var(--content-width);
		margin: 0 auto;
	}

	.travel-detail header {
		margin-bottom: 3rem;
	}

	.travel-detail h1 {
		font-size: clamp(2.35rem, 5vw, 3.75rem);
		margin-bottom: 0.75rem;
		letter-spacing: 0;
		line-height: 1.1;
	}

	.date {
		display: block;
		font-size: 0.9rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-text-light);
		margin-bottom: 2rem;
	}

	.description {
		font-size: 1.25rem;
		line-height: 1.6;
		color: var(--color-text-light);
		margin-bottom: 2rem;
		max-width: 50ch;
	}

	hr {
		border: 0;
		border-top: 1px solid var(--color-border);
		margin: 4rem 0;
	}

	.content {
		line-height: 1.8;
		font-size: 1.25rem;
		color: var(--color-text);
	}

	.content :global(figure) {
		margin: 4rem 0;
		width: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.content :global(img) {
		max-width: 100%;
		height: auto;
		border-radius: var(--radius);
		box-shadow: var(--shadow-md);
		margin-bottom: 1rem;
		display: block;
		border: 1px solid var(--color-border);
	}

	@media (min-width: 600px) {
		.content :global(img) {
			max-width: 650px;
		}
	}

	.content :global(figcaption) {
		font-style: italic;
		text-align: center;
		font-size: 0.95rem;
		color: var(--color-text-light);
		line-height: 1.5;
		max-width: 500px;
	}

	.travel-detail footer {
		margin-top: 6rem;
		padding-top: 3rem;
		border-top: 1px solid var(--color-border);
	}

	.travel-detail footer a {
		font-weight: 600;
		color: var(--color-text-light);
		transition: color 0.2s;
	}

	.travel-detail footer a:hover {
		color: var(--color-accent);
	}

	@media (max-width: 600px) {
		.travel-detail header {
			text-align: left;
			margin-bottom: 2rem;
		}

		.travel-detail h1 {
			font-size: 2.25rem;
		}

		.description {
			font-size: 1.1rem;
		}

		.content {
			font-size: 1.1rem;
		}
	}
</style>
