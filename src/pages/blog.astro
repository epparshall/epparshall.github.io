---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = await getCollection('blog', ({ data }) => {
	return data.draft !== true;
});
posts.sort((a, b) => {
	const dateDiff = b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
	if (dateDiff !== 0) return dateDiff;

	if (
		a.data.seriesTitle &&
		a.data.seriesTitle === b.data.seriesTitle &&
		a.data.seriesPart &&
		b.data.seriesPart
	) {
		return a.data.seriesPart - b.data.seriesPart;
	}

	return a.data.title.localeCompare(b.data.title);
});

const allTags = Array.from(
	new Set(posts.flatMap((post) => post.data.tags || []))
).sort();
---

<BaseLayout title="Blog" description="Evan Parshall's writing on technology, AI, health, personal finance, travel, and ideas worth sharing.">
	<header class="page-header">
		<h1>Blog</h1>
		<p class="subtitle">Writing on technology, health and wellness, finance, travel, politics, and ideas worth sharing.</p>
	</header>

	<div class="blog-filters">
		<input
			type="search"
			id="search-input"
			placeholder="Search posts..."
			aria-label="Search posts"
			autocomplete="off"
		/>

		{allTags.length > 0 && (
			<div class="multi-select">
				<button type="button" id="tag-trigger" class="multi-select-trigger" aria-haspopup="true" aria-expanded="false" aria-controls="tag-panel">
					<span id="trigger-text">Tags</span>
					<span class="chevron" aria-hidden="true">▾</span>
				</button>
				<div id="tag-panel" class="tag-panel hidden">
					<button type="button" id="clear-all-tags" class="tag-option clear-option">Clear filters</button>
					{allTags.map((tag) => (
						<label class="tag-option">
							<input type="checkbox" value={tag} />
							<span>{tag}</span>
						</label>
					))}
				</div>
			</div>
		)}
	</div>

	<div class="posts-list" id="posts-list">
		{posts.map((post) => (
			<article
				class="post-card"
				data-title={post.data.title.toLowerCase()}
				data-description={post.data.description.toLowerCase()}
				data-tags={(post.data.tags || []).join(',')}
				data-series={post.data.seriesTitle?.toLowerCase() || ''}
			>
				<a href={`/blog/${post.id}`}>
					<div class="post-meta">
						<time datetime={post.data.pubDate.toISOString()}>
							{post.data.pubDate.toLocaleDateString('en-US', {
								year: 'numeric',
								month: 'long',
								timeZone: 'UTC'
							})}
						</time>
						{post.data.seriesTitle && post.data.seriesPart && post.data.seriesTotal && (
							<span class="series-chip">
								{post.data.seriesTitle} Series {post.data.seriesPart}/{post.data.seriesTotal}
							</span>
						)}
					</div>
					<h2>{post.data.title}</h2>
					<p>{post.data.description}</p>
					{post.data.tags && post.data.tags.length > 0 && (
						<div class="post-tags">
							{post.data.tags.map((tag) => (
								<span class="tag">{tag}</span>
							))}
						</div>
					)}
					<span class="read-more">Read post &rarr;</span>
				</a>
			</article>
		))}
	</div>

	<p id="no-results" class="no-results" style="display: none;" role="status">
		No posts match your search or selected tags.
	</p>

	<script>
		(function () {
			const searchInput = document.getElementById('search-input');
			const postsList = document.getElementById('posts-list');
			const noResults = document.getElementById('no-results');
			const trigger = document.getElementById('tag-trigger');
			const panel = document.getElementById('tag-panel');
			const multiSelect = trigger ? trigger.closest('.multi-select') : null;
			const checkboxes = panel ? panel.querySelectorAll('input[type="checkbox"]') : [];
			const clearOption = document.getElementById('clear-all-tags');

			if (!searchInput || !postsList || !trigger || !panel) return;

			const cards = postsList.querySelectorAll('.post-card');
			let activeTags = new Set();

			function syncCheckboxes() {
				checkboxes.forEach(cb => {
					cb.checked = activeTags.has(cb.value);
				});
			}

			function updateTriggerText() {
				const count = activeTags.size;
				const textEl = document.getElementById('trigger-text');
				if (!textEl) return;

				if (count === 0) {
					textEl.textContent = 'Tags';
					if (multiSelect) multiSelect.classList.remove('has-selection');
				} else if (count === 1) {
					textEl.textContent = Array.from(activeTags)[0];
					if (multiSelect) multiSelect.classList.add('has-selection');
				} else {
					const tags = Array.from(activeTags);
					if (count === 2) {
						textEl.textContent = `${tags[0]}, ${tags[1]}`;
					} else {
						textEl.textContent = `${tags[0]}, ${tags[1]} +${count - 2}`;
					}
					if (multiSelect) multiSelect.classList.add('has-selection');
				}
			}

			function clearAllFilters() {
				searchInput.value = '';
				activeTags.clear();
				checkboxes.forEach(cb => { cb.checked = false; });
				closePanel();
				updateAll();
			}

			function updateAll() {
				updateTriggerText();
				filterPosts();
			}

			function filterPosts() {
				const term = searchInput.value.toLowerCase().trim();
				let visibleCount = 0;

				cards.forEach((card) => {
					const title = card.dataset.title || '';
					const description = card.dataset.description || '';
					const series = card.dataset.series || '';
					const cardTagsStr = card.dataset.tags || '';
					const cardTags = cardTagsStr ? cardTagsStr.split(',') : [];

					const matchesSearch =
						!term ||
						title.includes(term) ||
						description.includes(term) ||
						series.includes(term) ||
						cardTags.some((t) => t.toLowerCase().includes(term));

					const matchesTags =
						activeTags.size === 0 ||
						Array.from(activeTags).some((t) => cardTags.includes(t));

					if (matchesSearch && matchesTags) {
						card.style.display = '';
						visibleCount++;
					} else {
						card.style.display = 'none';
					}
				});

				if (noResults) {
					noResults.style.display = visibleCount === 0 ? 'block' : 'none';
				}
			}

			function setTagActive(tag, isActive) {
				if (isActive) {
					activeTags.add(tag);
				} else {
					activeTags.delete(tag);
				}
				updateAll();
			}

			// Search
			searchInput.addEventListener('input', filterPosts);

			// Checkbox changes in dropdown
			checkboxes.forEach((cb) => {
				cb.addEventListener('change', () => {
					setTagActive(cb.value, cb.checked);
				});
			});

			// Clear filters option inside dropdown
			if (clearOption) {
				clearOption.addEventListener('click', (e) => {
					e.stopPropagation();
					clearAllFilters();
				});
			}

			// Dropdown open / close
			function openPanel() {
				syncCheckboxes();
				panel.classList.remove('hidden');
				trigger.setAttribute('aria-expanded', 'true');
				if (multiSelect) multiSelect.classList.add('open');
			}

			function closePanel() {
				panel.classList.add('hidden');
				trigger.setAttribute('aria-expanded', 'false');
				if (multiSelect) multiSelect.classList.remove('open');
			}

			trigger.addEventListener('click', (e) => {
				e.stopPropagation();
				if (panel.classList.contains('hidden')) {
					openPanel();
				} else {
					closePanel();
				}
			});

			// Close when clicking outside
			document.addEventListener('click', (e) => {
				if (multiSelect && !multiSelect.contains(e.target)) {
					closePanel();
				}
			});

			// Escape closes the panel and returns focus to the trigger
			document.addEventListener('keydown', (e) => {
				if (e.key === 'Escape' && !panel.classList.contains('hidden')) {
					closePanel();
					trigger.focus();
				}
			});

			// Initial
			updateAll();
		})();
	</script>
</BaseLayout>

<style>
	.page-header {
		margin-bottom: 1.5rem;
	}

	.page-header h1 {
		font-size: clamp(2.75rem, 6vw, 4rem);
		margin-bottom: 1rem;
		letter-spacing: 0;
		line-height: 1.08;
	}

	.subtitle {
		font-size: 1.25rem;
		color: var(--color-text-light);
		max-width: 72ch;
		line-height: 1.4;
	}

	.posts-list {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.post-card a {
		display: block;
		padding: 2rem;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		box-shadow: var(--shadow-sm);
		transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
		color: inherit;
		text-decoration: none;
	}

	.post-card a:hover {
		transform: translateY(-3px);
		box-shadow: var(--shadow-md);
		border-color: rgba(47, 111, 94, 0.45);
		background: var(--color-surface);
		opacity: 1;
	}

	.post-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.6rem;
		margin-bottom: 1rem;
	}

	.post-card time {
		font-size: 0.85rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-text-light);
	}

	.series-chip {
		display: inline-flex;
		align-items: center;
		min-height: 1.6rem;
		padding: 0.2rem 0.55rem;
		border: 1px solid rgba(166, 86, 69, 0.28);
		border-radius: 999px;
		background: rgba(166, 86, 69, 0.08);
		color: var(--color-accent-warm);
		font-size: 0.78rem;
		font-weight: 750;
		line-height: 1;
	}

	.post-card h2 {
		margin-top: 0;
		font-size: 1.75rem;
		margin-bottom: 1rem;
		color: var(--color-text);
		line-height: 1.3;
	}

	.post-card p {
		font-size: 1.1rem;
		color: var(--color-text-light);
		margin-bottom: 1.5rem;
		line-height: 1.6;
	}

	.read-more {
		font-size: 0.95rem;
		font-weight: 600;
		color: var(--color-accent-strong);
	}

	.post-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-top: 0.25rem;
		margin-bottom: 0.75rem;
	}

	.tag {
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		padding: 0.15rem 0.55rem;
		background-color: var(--color-surface-muted, #f4f7f5);
		color: var(--color-text-light);
		border-radius: 999px;
		border: 1px solid var(--color-border);
	}

	.blog-filters {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(180px, 220px);
		gap: 0.75rem;
		align-items: center;
		margin-bottom: 2rem;
		padding: 0.65rem;
		background: rgba(255, 255, 255, 0.72);
		border: 1px solid rgba(220, 228, 223, 0.9);
		border-radius: var(--radius);
		box-shadow: var(--shadow-sm);
	}

	#search-input {
		width: 100%;
		min-width: 0;
		padding: 0.75rem 1rem;
		font-size: 1rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		background-color: rgba(255, 255, 255, 0.95);
		color: var(--color-text);
		outline: none;
		transition: border-color 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
		height: 48px;
	}

	#search-input:focus {
		border-color: var(--color-accent);
		box-shadow: 0 0 0 3px var(--color-accent-soft);
		background-color: var(--color-surface);
	}

	/* Multi-select dropdown */
	.multi-select {
		position: relative;
		min-width: 0;
	}

	.multi-select-trigger {
		width: 100%;
		height: 48px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0 0.95rem;
		font-size: 0.95rem;
		font-weight: 650;
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		background-color: rgba(255, 255, 255, 0.95);
		color: var(--color-text-light);
		cursor: pointer;
		transition: border-color 0.2s ease, box-shadow 0.2s ease, color 0.2s ease, background-color 0.2s ease;
		text-align: left;
		white-space: nowrap;
		overflow: hidden;
	}

	.multi-select-trigger:hover {
		border-color: var(--color-accent);
		background-color: var(--color-surface);
	}

	.multi-select-trigger:focus-visible {
		outline: none;
		border-color: var(--color-accent);
		box-shadow: 0 0 0 3px var(--color-accent-soft);
	}

	.multi-select.has-selection .multi-select-trigger {
		color: var(--color-text);
		border-color: var(--color-accent);
		background-color: var(--color-surface);
	}

	.multi-select-trigger .chevron {
		font-size: 0.75em;
		margin-left: 0.4rem;
		flex-shrink: 0;
		transition: transform 0.2s ease;
	}

	.multi-select.open .chevron {
		transform: rotate(180deg);
	}

	.tag-panel {
		position: absolute;
		top: calc(100% + 8px);
		left: 0;
		width: 100%;
		min-width: 220px;
		z-index: 20;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		box-shadow: var(--shadow-md);
		padding: 0.25rem 0;
		max-height: 220px;
		overflow-y: auto;
	}

	.tag-panel.hidden {
		display: none;
	}

	.tag-option {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.35rem 0.75rem;
		font-size: 0.9rem;
		cursor: pointer;
		color: var(--color-text);
	}

	.tag-option:hover {
		background: var(--color-accent-soft);
	}

	.tag-option input[type="checkbox"] {
		width: 14px;
		height: 14px;
		accent-color: var(--color-accent);
		margin: 0;
		flex-shrink: 0;
	}

	.clear-option {
		width: 100%;
		border: 0;
		border-bottom: 1px solid var(--color-border);
		background: none;
		font: inherit;
		text-align: left;
		font-weight: 600;
		color: var(--color-accent-strong);
		border-bottom: 1px solid var(--color-border);
		margin-bottom: 0.2rem;
	}

	.clear-option:hover {
		background: var(--color-accent-soft);
	}

	.no-results {
		color: var(--color-text-light);
		font-style: italic;
		padding: 1rem 0;
	}

	@media (max-width: 600px) {
		.page-header {
			margin-bottom: 1rem;
			text-align: left;
		}

		.page-header h1 {
			font-size: 2.3rem;
			margin-bottom: 0.75rem;
		}

		.subtitle {
			font-size: 1rem;
			line-height: 1.45;
			margin-bottom: 0;
		}

		.post-card a {
			padding: 1.15rem;
		}

		.post-card h2 {
			font-size: 1.35rem;
			margin-bottom: 0.65rem;
		}

		.post-card p {
			font-size: 1rem;
			line-height: 1.5;
			margin-bottom: 1rem;
		}

		.post-card time {
			font-size: 0.78rem;
		}

		.post-meta {
			gap: 0.45rem;
			margin-bottom: 0.75rem;
		}

		.series-chip {
			min-height: 1.45rem;
			font-size: 0.72rem;
			padding: 0.16rem 0.45rem;
		}

		.post-tags {
			gap: 0.3rem;
			margin-bottom: 0.5rem;
		}

		.tag {
			font-size: 0.65rem;
			padding: 0.1rem 0.45rem;
		}

		.blog-filters {
			grid-template-columns: 1fr;
			gap: 0.5rem;
			margin-bottom: 1.25rem;
			padding: 0.55rem;
		}

		#search-input {
			font-size: 16px; /* prevents iOS Safari auto-zoom on focus */
			padding: 0.65rem 0.75rem;
			height: 44px;
		}

		.multi-select-trigger {
			font-size: 0.9rem;
			padding: 0 0.75rem;
			height: 44px;
		}

		.tag-option {
			font-size: 0.82rem;
			padding: 0.25rem 0.5rem;
		}

		.clear-option {
			font-size: 0.82rem;
			padding: 0.25rem 0.5rem;
		}

		.tag-panel {
			min-width: 100%;
		}
	}
</style>
