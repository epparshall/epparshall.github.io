---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const destinations = await getCollection('travel');
destinations.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Travel" description="Evan Parshall's travel stories and practical advice from Colombia, Peru, Switzerland, Germany, India, Guatemala, Portugal, and Spain.">
	<header class="page-header">
		<h1>Travel</h1>
		<p class="subtitle">Time doesn’t pass quickly because it is full, but because it is repetitive. Novelty is what anchors memory, and memory is what we mistake for time lived. To travel is to interrupt sameness long enough for life to become legible again.</p>
	</header>

	<section class="resources-link">
		<a href="/travel/resources">
			<span class="icon">✈️</span>
			<div class="resource-text">
				<strong>General Tips & Resources</strong>
				<p>Strategies for packing, gear, and travel logistics.</p>
			</div>
			<span class="arrow">&rarr;</span>
		</a>
	</section>

	<section class="destinations-section">
		<h2 class="section-title">Destinations</h2>
		<div class="travel-list">
			{destinations.map((dest) => (
				<article class="travel-item">
					<a href={`/travel/${dest.id}`} class="travel-card">
						{dest.data.image && (
							<img
								class="travel-cover"
								src={dest.data.image}
								alt=""
								loading="lazy"
								decoding="async"
							/>
						)}
						<time class="date" datetime={dest.data.date.toISOString()}>
							{dest.data.date.toLocaleDateString('en-US', {
								year: 'numeric',
								month: 'long',
								timeZone: 'UTC',
							})}
						</time>
						<h2>{dest.data.destination}</h2>
						{dest.data.description && <p>{dest.data.description}</p>}
						<span class="read-more">Read travel review &rarr;</span>
					</a>
				</article>
			))}
		</div>
	</section>
</BaseLayout>

<style>
	.page-header {
		margin-bottom: 4rem;
	}

	.page-header h1 {
		font-size: clamp(2.75rem, 6vw, 4rem);
		margin-bottom: 1.5rem;
		letter-spacing: 0;
		line-height: 1.08;
	}

	.subtitle {
		font-size: 1.25rem;
		color: var(--color-text-light);
		max-width: 65ch;
		line-height: 1.6;
	}

	.resources-link {
		margin: 4rem 0;
	}

	.resources-link a {
		display: flex;
		align-items: center;
		padding: 1.35rem 1.5rem;
		background: linear-gradient(135deg, var(--color-accent-soft), rgba(166, 86, 69, 0.08));
		border-radius: var(--radius);
		text-decoration: none;
		color: inherit;
		border: 1px solid var(--color-border);
		box-shadow: var(--shadow-sm);
		transition: border-color 0.2s ease;
	}

	.resources-link a:hover {
		border-color: rgba(47, 111, 94, 0.45);
		opacity: 1;
	}

	.resources-link .icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.75rem;
		height: 2.75rem;
		margin-right: 1.25rem;
		border-radius: var(--radius);
		background: var(--color-surface);
		font-size: 1.35rem;
		box-shadow: var(--shadow-sm);
	}

	.resource-text {
		flex: 1;
	}

	.resource-text strong {
		display: block;
		font-size: 1.25rem;
		margin-bottom: 0.25rem;
		color: var(--color-text);
	}

	.resource-text p {
		margin-bottom: 0;
		font-size: 0.95rem;
		color: var(--color-text-light);
	}

	.resources-link .arrow {
		color: var(--color-accent-strong);
		font-size: 1.5rem;
		font-weight: bold;
	}

	.section-title {
		font-size: 0.85rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-text-light);
		margin-bottom: 2rem;
		border-bottom: 1px solid var(--color-border);
		padding-bottom: 0.5rem;
		display: inline-block;
	}

	.travel-list {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 1rem;
	}

	.travel-card {
		display: block;
		padding: 2rem;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		box-shadow: var(--shadow-sm);
		transition: border-color 0.2s ease;
		color: inherit;
		text-decoration: none;
		height: 100%;
	}

	.travel-card {
		overflow: hidden;
	}

	.travel-cover {
		display: block;
		width: calc(100% + 4rem);
		max-width: none;
		height: 200px;
		margin: -2rem -2rem 1.5rem;
		object-fit: cover;
		background: var(--color-surface-muted);
	}

	.travel-card:hover {
		border-color: rgba(47, 111, 94, 0.45);
		background: var(--color-surface);
		opacity: 1;
	}

	.date {
		display: block;
		font-size: 0.85rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-text-light);
		margin-bottom: 1rem;
	}

	.travel-card h2 {
		margin-top: 0;
		font-size: 1.75rem;
		margin-bottom: 1rem;
		color: var(--color-text);
		line-height: 1.3;
	}

	.travel-card p {
		font-size: 1rem;
		color: var(--color-text-light);
		margin-bottom: 1.5rem;
		line-height: 1.6;
	}

	.read-more {
		font-size: 0.95rem;
		font-weight: 600;
		color: var(--color-accent-strong);
	}

	@media (max-width: 600px) {
		.page-header {
			margin-bottom: 1.75rem;
			text-align: left;
		}

		.page-header h1 {
			font-size: 2.3rem;
			margin-bottom: 0.75rem;
		}

		.subtitle {
			font-size: 1rem;
			line-height: 1.45;
			margin-bottom: 0;
		}

		.resources-link {
			margin: 2rem 0;
		}

		.resources-link a {
			padding: 1rem;
			gap: 0.8rem;
		}

		.resources-link .icon {
			width: 2.35rem;
			height: 2.35rem;
			margin-right: 0;
		}

		.resource-text strong {
			font-size: 1.05rem;
		}

		.resource-text p {
			font-size: 0.9rem;
			line-height: 1.35;
		}

		.section-title {
			margin-bottom: 1rem;
		}

		.travel-card {
			padding: 1.15rem;
		}

		.travel-cover {
			width: calc(100% + 2.3rem);
			height: 170px;
			margin: -1.15rem -1.15rem 1rem;
		}

		.travel-card h2 {
			font-size: 1.35rem;
			margin-bottom: 0.65rem;
		}

		.travel-card p {
			line-height: 1.45;
			margin-bottom: 1rem;
		}
	}
</style>
